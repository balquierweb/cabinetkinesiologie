:root{--paper:#faf8f2;--ink:#26382d;--muted:#4d5c50;--green:#2e4838;--sage:#dce5d9;--line:#cad4c7;--serif:Fraunces,Georgia,serif;--sans:"DM Sans",system-ui,sans-serif}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--ink);font:1rem/1.65 var(--sans)}
img{display:block;max-width:100%}
a{color:inherit;text-underline-offset:.3em}
a:hover{text-decoration-thickness:2px}
:focus-visible{outline:3px solid #a36142;outline-offset:5px}
.wrap{width:min(1180px,calc(100% - 88px));margin-inline:auto}
.skip{position:absolute;top:-200px;left:1rem;background:white;padding:.5rem;z-index:5}
.skip:focus{top:1rem}
.header{border-bottom:1px solid var(--line)}
.bar{min-height:90px;display:flex;align-items:center;justify-content:space-between;gap:22px}
.brand{display:flex;align-items:center;gap:9px;text-decoration:none;font:500 1.37rem/1.05 var(--serif)}
.brand img{object-fit:contain}
.brand small{display:block;font:600 .72rem var(--sans);letter-spacing:.08em;margin-top:5px;text-transform:uppercase}
nav{display:flex;align-items:center;gap:clamp(15px,3vw,38px)}
nav a{font-weight:600;text-decoration:none;white-space:nowrap}
nav a:hover{text-decoration:underline}
.button{display:inline-flex;min-height:48px;align-items:center;justify-content:center;padding:.7rem 1.25rem;border-radius:4px;font-weight:700;text-decoration:none;line-height:1.25;text-align:center}
.primary{background:var(--green);color:white}
.primary:hover{background:#41604a}
.light{background:var(--paper);color:var(--green)}
.light:hover{background:var(--sage)}
.hero{min-height:570px;display:grid;grid-template-columns:1.02fr 1fr;align-items:center;gap:clamp(28px,5vw,68px);padding-block:55px}
.hero-copy>p:not(.eyebrow){max-width:430px;font-size:1.16rem;color:var(--muted)}
.eyebrow{text-transform:uppercase;font-size:.88rem;letter-spacing:.1em;font-weight:700;margin:0 0 1rem}
h1,h2,h3{font-family:var(--serif);font-weight:400;line-height:1.08;margin:0}
h1{font-size:clamp(3rem,5.5vw,5.25rem);letter-spacing:-.045em}
h1 em{font-weight:400;color:#476453}
h2{font-size:clamp(2.15rem,4.1vw,3.65rem);letter-spacing:-.035em}
h3{font-size:1.65rem;letter-spacing:-.02em}
.actions{margin-top:27px;display:flex;gap:20px;flex-wrap:wrap;align-items:center}
.text-link{font-weight:700}
.hero-image{margin:0;height:clamp(340px,39vw,505px);overflow:hidden;border-radius:48% 48% 6px 6px / 40% 40% 6px 6px;background:var(--sage)}
.hero-image img,.about-picture img{width:100%;height:100%;object-fit:cover}
.section{padding-block:clamp(52px,8vw,105px)}
.section-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:32px}
.section-head p{max-width:340px;margin:0;color:var(--muted)}
.practices,.reviews{background:var(--sage)}
.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;align-items:start}
article{background:var(--paper);overflow:hidden;border-radius:6px}
article>img{width:100%;height:195px;object-fit:contain;background:#222e15}
.card-copy{padding:22px}
.card-copy p{margin:.65rem 0 1rem;color:var(--muted)}
details{border-top:1px solid var(--line);padding-top:.65rem}
summary{cursor:pointer;font-weight:700}
summary:hover{text-decoration:underline;text-underline-offset:.25em}
details p:last-child{margin-bottom:0}
.about,.rates{display:grid;grid-template-columns:1fr 1.2fr;gap:clamp(25px,7vw,100px);align-items:center}
.about-picture{height:clamp(300px,39vw,470px);border-radius:48% 48% 6px 6px / 40% 40% 6px 6px;overflow:hidden;background:var(--sage)}
.note{font-size:.95rem;color:var(--muted);border-left:2px solid var(--line);padding-left:14px}
.quotes{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.quotes figure{background:var(--paper);margin:0;padding:23px;border-radius:6px}
blockquote{font:1.35rem/1.35 var(--serif);margin:0 0 15px}
figcaption{color:var(--muted)}
.rates{align-items:start}
.price-list details{padding:14px 0}
.price-list details:last-child{border-bottom:1px solid var(--line)}
.price-list summary span{float:right;margin-left:.6rem;font-variant-numeric:tabular-nums}
.price-list details p{padding-left:1.15rem}
.booking{background:var(--green);color:var(--paper)}
.booking-inner{display:flex;align-items:center;justify-content:space-between;gap:22px;padding-block:50px}
.booking p{margin:10px 0 0}
.booking .button{flex-shrink:0}
.footer-grid{display:grid;grid-template-columns:1.05fr 1fr .85fr;gap:22px;padding-block:48px}
.footer-grid h2{font-size:2.25rem}
.footer-grid h3{font-size:1.35rem;margin-bottom:9px}
.footer-grid ul{list-style:none;margin:0;padding:0}
address{font-style:normal}
.footer-bottom{border-top:1px solid var(--line);padding-block:20px;color:var(--muted)}
@media(max-width:900px){.wrap{width:calc(100% - 48px)}.bar{flex-wrap:wrap;padding-block:14px}.bar nav{order:3;width:100%;padding-top:9px;border-top:1px solid var(--line);justify-content:space-between;flex-wrap:wrap}.cards{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:620px){.wrap{width:calc(100% - 32px)}.bar{gap:12px}.bar nav{gap:8px 14px;font-size:.94rem}.bar .button{max-width:140px;font-size:.85rem;padding-inline:.65rem}.hero,.about,.rates{grid-template-columns:1fr}.hero{padding-block:39px 28px;min-height:0}.hero-image{height:330px}.section-head,.booking-inner{display:block}.section-head p{margin-top:10px}.cards,.quotes,.footer-grid{grid-template-columns:1fr}.booking .button{margin-top:18px}.about-picture{height:355px}.footer-grid{gap:28px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
